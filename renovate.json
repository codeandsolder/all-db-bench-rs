{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>codeandsolder/ci-workflows:renovate-fleet"
  ],
  "packageRules": [
    {
      "description": "SurrealDB 4 removed its RocksDB engine entirely. This is an explicit comparison of SurrealDB on actual RocksDB, not SurrealKV; preserve the 3.x RocksDB benchmark until that engine is deliberately retired.",
      "matchManagers": [
        "cargo"
      ],
      "matchFileNames": [
        "engines/surrealdb-rocksdb/Cargo.toml"
      ],
      "matchPackageNames": [
        "surrealdb"
      ],
      "allowedVersions": "<4"
    },
    {
      "description": "Collect all ordinary dependency updates into one scheduled batch; retain inherited per-update review and release-age rules.",
      "matchPackageNames": [
        "*"
      ],
      "groupName": "Dependency update batch",
      "groupSlug": "dependency-update-batch",
      "schedule": [
        "* 0-3 3-30/3 * *"
      ],
      "timezone": "Etc/UTC",
      "updateNotScheduled": false,
      "separateMajorMinor": false,
      "separateMinorPatch": false,
      "separateMultipleMajor": false,
      "separateMultipleMinor": false
    },
    {
      "description": "Standalone lockfile refresh only when no ordinary update batch takes priority",
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "prPriority": -1
    }
  ],
  "timezone": "Etc/UTC",
  "schedule": [
    "* 0-3 3-30/3 * *"
  ],
  "updateNotScheduled": false,
  "rebaseWhen": "conflicted",
  "prConcurrentLimit": 1,
  "branchConcurrentLimit": 1,
  "prHourlyLimit": 1,
  "commitHourlyLimit": 1,
  "separateMajorMinor": false,
  "separateMinorPatch": false,
  "separateMultipleMajor": false,
  "separateMultipleMinor": false,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "* 0-3 3-30/3 * *"
    ],
    "updateNotScheduled": false
  }
}
