[Unit]
Description=sccache local-only daemon for host-native benchmark builds
Wants=network-online.target
After=network-online.target garage-sccache.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=root
Group=root
Environment=HOME=/root
Environment=RUSTUP_HOME=/root/.rustup
Environment=CARGO_HOME=/root/.cargo
Environment=PATH=/root/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
Environment=SCCACHE_SERVER_PORT=4237
Environment=SCCACHE_CONF=/etc/sccache/client-native-local.conf
Environment=SCCACHE_START_SERVER=1
Environment=SCCACHE_NO_DAEMON=1
Environment=SCCACHE_IDLE_TIMEOUT=0
Environment=SCCACHE_EXPERIMENTAL_CANONICAL_RUST=1
EnvironmentFile=/etc/sccache/garage-laptop.env
ExecStart=/usr/local/libexec/sccache-bin/sccache
Restart=on-failure
RestartSec=2s
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
